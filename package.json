{
  "name": "snappymail-brandable",
  "title": "Brandable SnappyMail",
  "description": "Brandable web-based email client forked from SnappyMail",
  "private": true,
  "version": "2.38.2",
  "homepage": "https://github.com/Leopere/snappymail-brandable",
  "author": {
    "name": "DJ Maze",
    "email": "support@snappymail.eu",
    "web": "https://snappymail.eu"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/Leopere/snappymail-brandable.git"
  },
  "scripts": {
    "build": "gulp build",
    "check": "gulp lint",
    "dev": "node scripts/dev-local.js",
    "dev:tunnel": "SNAPPYMAIL_TUNNEL=1 node scripts/dev-local.js",
    "provision:local-gpg": "node scripts/provision-local-internal-gpg.cjs",
		"provision:miab-gpg": "node scripts/provision-miab-domain-gnupg.cjs",
		"openpgp:cutover:plan": "node scripts/openpgp-clean-cutover.cjs",
		"openpgp:cutover:scrub": "node scripts/openpgp-clean-cutover.cjs --execute",
		"openpgp:cutover:verify": "node scripts/openpgp-clean-cutover.cjs --verify",
		"test": "npm run test:security && npm run test:ui",
		"test:security": "node tests/security/html-sanitizer.cjs && node tests/security/notomo-login-privacy.cjs && node tests/security/action-log-redaction.cjs && node tests/security/remember-me-storage.cjs && node tests/security/rocksign-integration.cjs && node tests/security/rocksign-browser.cjs && node tests/security/mobile-message-swipes.cjs && node tests/security/inbox-mobile-contract.cjs && node tests/security/message-view-information-architecture.cjs && node tests/security/folder-subscription-visibility.cjs && node tests/security/smart-archive-setup.cjs && node tests/security/newsletter-sieve.cjs && node tests/security/bulk-read-sync.cjs && node tests/security/delivery-receipt-summary.cjs && node tests/security/message-classifier.cjs && node tests/security/email-classifier-assets.cjs && npm run test:openpgp && npm run test:contacts && npm run test:deploy",
		"test:classifier:worker": "node tests/playwright/email-classifier-worker.cjs",
		"test:openpgp": "node tests/security/openpgp-regressions.cjs && node tests/security/openpgp-public-key-queue.cjs && node tests/security/wkd-discovery.cjs && node tests/security/wkd-static-sync.cjs && node tests/security/openpgp-vault-browser.cjs && node tests/security/openpgp-vault-lifecycle.cjs && node tests/security/openpgp-clean-cutover.cjs",
		"test:contacts": "node tests/security/contact-favorites.cjs",
		"test:deploy": "node tests/security/deploy-contract.cjs",
		"test:static-build": "node tests/security/static-build-continuity.cjs",
		"test:openpgp:live": "node tests/playwright/openpgp-send-contract.cjs",
		"test:openpgp-send-contract": "npm run test:openpgp:live",
		"test:snooze:live": "playwright test tests/playwright/snappymail-snooze.spec.cjs --reporter=line",
		"test:snooze:due:live": "SNAPPYMAIL_TEST_SNOOZE_DUE=1 playwright test tests/playwright/snappymail-snooze.spec.cjs --grep 'due Snooze' --reporter=line",
		"verify:openpgp": "npm run test:static-build && npm run check && npm run test:openpgp && npm run test:openpgp:live",
		"test:openpgp:cutover": "node tests/playwright/openpgp-clean-cutover.cjs",
		"verify:openpgp:cutover": "npm run test:openpgp:cutover && npm run openpgp:cutover:verify",
		"test:legacy-transport": "node tests/security/openpgp-legacy-transport.cjs",
		"test:ui": "docker compose up -d --build snappymail db docker-mailserver && node scripts/refresh-tunnel-if-running.js && npm run provision:local-gpg && playwright test tests/playwright/snappymail-ui.spec.cjs --reporter=line",
    "test:audit": "playwright test tests/playwright/snappymail-audit.spec.cjs --reporter=line",
    "test:audit:route": "SNAPPYMAIL_AUDIT_CASES=route playwright test tests/playwright/snappymail-audit.spec.cjs --reporter=line",
    "test:audit:route:boompay": "SNAPPYMAIL_AUDIT_CASES=route SNAPPYMAIL_AUDIT_DOMAINS=boompay.ca playwright test tests/playwright/snappymail-audit.spec.cjs --reporter=line",
    "test:audit:route:nixc": "SNAPPYMAIL_AUDIT_CASES=route SNAPPYMAIL_AUDIT_DOMAINS=nixc.us playwright test tests/playwright/snappymail-audit.spec.cjs --reporter=line",
    "test:audit:accounts": "SNAPPYMAIL_AUDIT_CASES=accounts playwright test tests/playwright/snappymail-audit.spec.cjs --reporter=line",
    "test:audit:bootstrap": "SNAPPYMAIL_AUDIT_CASES=bootstrap playwright test tests/playwright/snappymail-audit.spec.cjs --reporter=line",

    "test:audit:mailbox": "SNAPPYMAIL_AUDIT_CASES=mailbox-actions playwright test tests/playwright/snappymail-audit.spec.cjs --reporter=line",
    "test:audit:mailbox:boompay": "SNAPPYMAIL_AUDIT_CASES=mailbox-actions SNAPPYMAIL_AUDIT_DOMAINS=boompay.ca playwright test tests/playwright/snappymail-audit.spec.cjs --reporter=line",
    "test:audit:mailbox:nixc": "SNAPPYMAIL_AUDIT_CASES=mailbox-actions SNAPPYMAIL_AUDIT_DOMAINS=nixc.us playwright test tests/playwright/snappymail-audit.spec.cjs --reporter=line",
    "test:audit:view": "SNAPPYMAIL_AUDIT_CASES=message-view playwright test tests/playwright/snappymail-audit.spec.cjs --reporter=line",
    "test:audit:view:boompay": "SNAPPYMAIL_AUDIT_CASES=message-view SNAPPYMAIL_AUDIT_DOMAINS=boompay.ca playwright test tests/playwright/snappymail-audit.spec.cjs --reporter=line",
    "test:audit:view:nixc": "SNAPPYMAIL_AUDIT_CASES=message-view SNAPPYMAIL_AUDIT_DOMAINS=nixc.us playwright test tests/playwright/snappymail-audit.spec.cjs --reporter=line",
    "test:audit:navigation": "SNAPPYMAIL_AUDIT_CASES=list-navigation playwright test tests/playwright/snappymail-audit.spec.cjs --reporter=line",
    "test:audit:navigation:boompay": "SNAPPYMAIL_AUDIT_CASES=list-navigation SNAPPYMAIL_AUDIT_DOMAINS=boompay.ca playwright test tests/playwright/snappymail-audit.spec.cjs --reporter=line",
    "test:audit:navigation:nixc": "SNAPPYMAIL_AUDIT_CASES=list-navigation SNAPPYMAIL_AUDIT_DOMAINS=nixc.us playwright test tests/playwright/snappymail-audit.spec.cjs --reporter=line",
    "test:audit:session": "SNAPPYMAIL_AUDIT_CASES=session playwright test tests/playwright/snappymail-audit.spec.cjs --reporter=line",
    "test:audit:session:boompay": "SNAPPYMAIL_AUDIT_CASES=session SNAPPYMAIL_AUDIT_DOMAINS=boompay.ca playwright test tests/playwright/snappymail-audit.spec.cjs --reporter=line",
    "test:audit:session:nixc": "SNAPPYMAIL_AUDIT_CASES=session SNAPPYMAIL_AUDIT_DOMAINS=nixc.us playwright test tests/playwright/snappymail-audit.spec.cjs --reporter=line",
    "test:audit:drafts": "SNAPPYMAIL_AUDIT_CASES=drafts playwright test tests/playwright/snappymail-audit.spec.cjs --reporter=line",
    "test:audit:drafts:boompay": "SNAPPYMAIL_AUDIT_CASES=drafts SNAPPYMAIL_AUDIT_DOMAINS=boompay.ca playwright test tests/playwright/snappymail-audit.spec.cjs --reporter=line",
    "test:audit:drafts:nixc": "SNAPPYMAIL_AUDIT_CASES=drafts SNAPPYMAIL_AUDIT_DOMAINS=nixc.us playwright test tests/playwright/snappymail-audit.spec.cjs --reporter=line",
    "test:audit:mobile": "SNAPPYMAIL_AUDIT_CASES=mobile playwright test tests/playwright/snappymail-audit.spec.cjs --reporter=line",
    "test:audit:keyboard": "SNAPPYMAIL_AUDIT_CASES=keyboard playwright test tests/playwright/snappymail-audit.spec.cjs --reporter=line",
    "test:audit:cross-domain": "SNAPPYMAIL_AUDIT_CASES=cross-domain playwright test tests/playwright/snappymail-audit.spec.cjs --reporter=line",
    "test:audit:lifecycle:prepare": "SNAPPYMAIL_AUDIT_CASES=lifecycle-prepare playwright test tests/playwright/snappymail-audit.spec.cjs --reporter=line",
    "test:audit:lifecycle:verify": "SNAPPYMAIL_AUDIT_CASES=lifecycle-verify playwright test tests/playwright/snappymail-audit.spec.cjs --reporter=line",
    "test:audit:seed": "node scripts/seed-audit-mail.cjs",
    "test:audit:seed:calendar": "node scripts/seed-audit-mail.cjs --calendar --count=1",
    "test:audit:calendar": "node scripts/seed-audit-mail.cjs --calendar --count=1 && SNAPPYMAIL_AUDIT_CASES=calendar playwright test tests/playwright/snappymail-audit.spec.cjs --reporter=line",
    "test:audit:caldav": "node scripts/audit-caldav-conflict.cjs",
    "verify": "npm run build && npm run check && npm test",
    "watch": "node scripts/watch-static.js",
    "watch-css": "gulp watchCss"
  },
  "license": "SEE LICENSE IN LICENSE",
  "licenses": [
    {
      "type": "AGPL 3.0",
      "ulr": "http://www.gnu.org/licenses/agpl-3.0.html"
    }
  ],
  "bugs": {
    "url": "https://github.com/Leopere/snappymail-brandable/issues"
  },
  "keywords": [
    "webmail",
    "php",
    "javascript",
    "simple",
    "modern",
    "mail",
    "web-based",
    "email",
    "client",
    "openpgp"
  ],
  "readmeFilename": "README.md",
  "dependencies": {
    "@rollup/plugin-node-resolve": "^13.1.3",
    "@rollup/plugin-replace": "^3.0.1",
    "babel-eslint": "^10.1.0",
    "del": "^6.0.0",
    "eslint": "^7.32.0",
    "gulp": "^5.0.0",
    "gulp-append-prepend": "^1.0.9",
    "gulp-cached": "^1.1.1",
    "gulp-clean-css": "^4.3.0",
    "gulp-concat": "^2.6.1",
    "gulp-eol": "^0.2.0",
    "gulp-eslint": "^6.0.0",
    "gulp-expect-file": "^2.0.0",
    "gulp-filter": "^6.0.0",
    "gulp-group-css-media-queries": "^1.2.2",
    "gulp-less": "^5.0.0",
    "gulp-rename": "^2.0.0",
    "gulp-replace": "^1.1.3",
    "gulp-rollup-2": "^1.2.1",
    "gulp-size": "^3.0.0",
    "gulp-terser": "^2.1.0",
    "rollup": "^2.80.0",
    "rollup-plugin-external-globals": "^0.6.1",
    "rollup-plugin-includepaths": "^0.2.4",
    "rollup-plugin-terser": "^7.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1"
  },
  "resolutions": {
    "brace-expansion": "1.1.13",
    "eslint/cross-spawn": "7.0.5",
    "gulp-eslint/eslint/cross-spawn": "6.0.6",
    "gulp-rollup-2/rollup": "2.80.0",
    "js-yaml": "3.15.0",
    "lodash": "4.17.21",
    "micromatch": "4.0.8",
    "minimatch": "3.1.4",
    "picomatch": "2.3.2"
  }
}
