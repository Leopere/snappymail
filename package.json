{
  "name": "snappymail-brandable",
  "title": "Brandable SnappyMail",
  "description": "Brandable web-based email client forked from SnappyMail",
  "private": true,
  "version": "2.38.2",
  "homepage": "https://github.com/Leopere/snappymail-brandable",
  "author": {
    "name": "DJ Maze",
    "email": "support@snappymail.eu",
    "web": "https://snappymail.eu"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/Leopere/snappymail-brandable.git"
  },
  "scripts": {
    "build": "gulp build",
    "check": "gulp lint",
    "dev": "node scripts/dev-local.js",
    "dev:tunnel": "SNAPPYMAIL_TUNNEL=1 node scripts/dev-local.js",
    "provision:local-gpg": "node scripts/provision-local-internal-gpg.cjs",
    "provision:miab-gpg": "node scripts/provision-miab-domain-gnupg.cjs",
    "test": "npm run test:security && npm run test:ui",
    "test:security": "node tests/security/html-sanitizer.cjs",
    "test:ui": "docker compose up -d --build snappymail db docker-mailserver && node scripts/refresh-tunnel-if-running.js && npm run provision:local-gpg && playwright test tests/playwright/snappymail-ui.spec.cjs --reporter=line",
    "verify": "npm run build && npm run check && npm test",
    "watch": "node scripts/watch-static.js",
    "watch-css": "gulp watchCss"
  },
  "license": "SEE LICENSE IN LICENSE",
  "licenses": [
    {
      "type": "AGPL 3.0",
      "ulr": "http://www.gnu.org/licenses/agpl-3.0.html"
    }
  ],
  "bugs": {
    "url": "https://github.com/Leopere/snappymail-brandable/issues"
  },
  "keywords": [
    "webmail",
    "php",
    "javascript",
    "simple",
    "modern",
    "mail",
    "web-based",
    "email",
    "client",
    "openpgp"
  ],
  "readmeFilename": "README.md",
  "dependencies": {
    "@rollup/plugin-node-resolve": "^13.1.3",
    "@rollup/plugin-replace": "^3.0.1",
    "babel-eslint": "^10.1.0",
    "del": "^6.0.0",
    "eslint": "^7.32.0",
    "gulp": "^5.0.0",
    "gulp-append-prepend": "^1.0.9",
    "gulp-cached": "^1.1.1",
    "gulp-clean-css": "^4.3.0",
    "gulp-concat": "^2.6.1",
    "gulp-eol": "^0.2.0",
    "gulp-eslint": "^6.0.0",
    "gulp-expect-file": "^2.0.0",
    "gulp-filter": "^6.0.0",
    "gulp-group-css-media-queries": "^1.2.2",
    "gulp-less": "^5.0.0",
    "gulp-rename": "^2.0.0",
    "gulp-replace": "^1.1.3",
    "gulp-rollup-2": "^1.2.1",
    "gulp-size": "^3.0.0",
    "gulp-terser": "^2.1.0",
    "rollup": "^2.80.0",
    "rollup-plugin-external-globals": "^0.6.1",
    "rollup-plugin-includepaths": "^0.2.4",
    "rollup-plugin-terser": "^7.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1"
  },
  "resolutions": {
    "brace-expansion": "1.1.13",
    "eslint/cross-spawn": "7.0.5",
    "gulp-eslint/eslint/cross-spawn": "6.0.6",
    "gulp-rollup-2/rollup": "2.80.0",
    "js-yaml": "3.15.0",
    "lodash": "4.17.21",
    "micromatch": "4.0.8",
    "minimatch": "3.1.4",
    "picomatch": "2.3.2"
  }
}
